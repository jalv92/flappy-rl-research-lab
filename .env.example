# All optional. Copy to .env only if you need to change a default (nothing here is a secret).

# Where experiments/ and checkpoints/ live (default: the project root).
# FLAPLAB_HOME=/path/to/lab-data

# Opt-in coding-agent hook used when the hypothesis queue is empty (see docs/research-methodology.md).
# Unset = no agent is ever invoked.
# FLAPLAB_AGENT_CMD=claude -p --permission-mode acceptEdits
# FLAPLAB_AGENT_TIMEOUT=1800

# After each research session the model list is curated automatically (best checkpoint per
# algorithm/variant, named like PPO_Baseline; the rest unlisted). Set to 0 to disable.
# FLAPLAB_AUTO_CURATE=1

# A fresh clone copies the shipped snapshot in seed/ (trained models + research records) into
# experiments/ and checkpoints/ on first start. Set to 0 to start with an empty lab instead.
# FLAPLAB_SEED=1
